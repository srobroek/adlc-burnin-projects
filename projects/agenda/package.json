{
  "name": "adlc-demo-agenda",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Conference agenda API: sessions by track, speakers and personal schedules with clash warnings",
  "scripts": {
    "start": "bun run src/server.ts",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun test"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
